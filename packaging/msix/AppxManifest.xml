<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the Microsoft Store build. build-msix.ps1 fills in
  $VERSION$ and $ARCH$.

  Identity Name, Identity Publisher and PublisherDisplayName MUST match the values
  Partner Center shows under Product management > Product identity.
  Store ID: 9P8H93Z0TGK4
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <Identity
    Name="AlejandroMoraDaz.Symlinker-SymlinkCreator"
    Publisher="CN=A312A118-8FCC-4887-ABFD-917260D9441A"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>Symlinker</DisplayName>
    <PublisherDisplayName>Alejandro MD</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Links must land where the user points, not in the package's private AppData copy. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de" />
    <Resource Language="es" />
    <Resource Language="fr" />
    <Resource Language="hi" />
    <Resource Language="it" />
    <Resource Language="ja" />
    <Resource Language="pt" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application Id="Symlinker" Executable="Symlinker.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Symlinker"
        Description="Create symbolic links, hard links and directory junctions."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- mklink needs admin rights for symbolic links. -->
    <rescap:Capability Name="allowElevation" />
    <!-- Required by the desktop6 virtualization opt-outs above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
